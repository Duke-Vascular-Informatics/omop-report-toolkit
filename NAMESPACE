export(.save_calibration_plot_from_table)
export(.save_calibration_plot_from_vectors)
export(.save_dual_calibration_plot)
export(.build_table1)
export(.strip_heading_autonumbering)

# ---- Imports — every bare (non `::`-qualified) call to another package in --
# ---- R/*.R must have its function named here, or it fails at runtime with --
# ---- "could not find function", regardless of what the CALLER has loaded. -
importFrom(officer, body_add_par, fp_border)
importFrom(flextable, flextable, set_header_labels, bold, fontsize, font,
           width, align, bg, color, hline, border_outer,
           set_table_properties, padding)
importFrom(stats, quantile)
importFrom(utils, read.csv)

# ggplot2, patchwork, and pROC are used only via explicit `pkg::fn()` calls
# throughout R/*.R (verified — no bare calls), so they need Imports: in
# DESCRIPTION (a caller must be able to install them) but no importFrom here.
