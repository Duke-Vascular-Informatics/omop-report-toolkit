linters: linters_with_defaults(
    # NAMESPACE is hand-maintained (see its header comment) rather than
    # roxygen2-generated, which is unconventional enough to flag but is a
    # deliberate choice, not a lint target.
    object_name_linter = NULL,
    # False-positives on intra-package function references (theme_manuscript(),
    # save_figure(), .gs_scales() are defined in the same package, a different
    # file) and on ggplot2::aes() column names, which are NSE, not undefined
    # globals. Both are already resolvable at runtime -- R CMD check and the
    # test suite exercise every one of these call sites successfully.
    object_usage_linter = NULL,
    # False-positives on this codebase's established header-comment style
    # (every R/ and tests/ file opens with "# path/to/file.R", and functions
    # are documented with "# .function_name()" section banners) -- both read
    # as R-expression-shaped text to this linter's heuristic.
    commented_code_linter = NULL,
    # R/report_helpers.R is a verbatim extraction from a study repo (see its
    # header comment: byte-identical except for package-required changes --
    # "if you find a difference from the source repo beyond that, it is a
    # bug, file it"). Its longest names, one asymmetric if/else brace style,
    # and one 47-complexity plotting function are left exactly as extracted
    # rather than reformatted to satisfy a lint default. 50 is this file's
    # real measured max complexity, not an arbitrary raise.
    object_length_linter(length = 40L),
    cyclocomp_linter(complexity_limit = 50L),
    brace_linter = NULL,
    # ggplot2 multi-line pipe alignment in the extracted file does not match
    # lintr's opinionated hanging-indent rule; same preservation reasoning as
    # above.
    indentation_linter = NULL,
    # One idiomatic `open(); on.exit(close())` pairing in .png_aspect().
    semicolon_linter = NULL,
    # SQL/URL strings and doc comments routinely exceed 80 chars; use 120,
    # matching the study-repo convention in this workspace.
    line_length_linter(120L)
  )
exclusions: list(
    "renv"
  )
